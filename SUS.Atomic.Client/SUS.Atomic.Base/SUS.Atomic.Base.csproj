<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	  <TargetFramework>netstandard2.1</TargetFramework>
	  <Version>0.1.8</Version>
	  <Authors>Pasha</Authors>
	  <Company>SUS Digital Productions</Company>
	  <Product>SUS.Atomic.Base</Product>
	  <PackageId>SUS.Atomic.Base</PackageId>
	  <Title>SUS Atomic Base Library</Title>
	  <PackageTags>atomicassets;atomictools;atomicmarket;blockchain;wax;eos;nft</PackageTags>
	  <Description>Core base classes and interfaces for SUS Atomic clients. Open source library for interacting with Atomic Assets, Atomic Market, and Atomic Tools APIs. Brought to you by SUS Digital Productions.</Description>
	  <PackageLicenseExpression>MIT</PackageLicenseExpression>
	  <PackageProjectUrl>https://github.com/SUS-Digital-Productions/sus-atomic-client</PackageProjectUrl>
	  <RepositoryUrl>https://github.com/SUS-Digital-Productions/sus-atomic-client</RepositoryUrl>
	  <RepositoryType>git</RepositoryType>
	  <PackageReadmeFile>README.md</PackageReadmeFile>
	  <PackageIcon>icon.png</PackageIcon>
	  <GenerateDocumentationFile>true</GenerateDocumentationFile>
	  <Nullable>enable</Nullable>
	  <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNet.WebApi.Client" Version="6.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="9.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
